{
    // 使用 IntelliSense 了解相关属性。 
    // 悬停以查看现有属性的描述。
    // 欲了解更多信息，请访问: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python 调试程序: 当前文件",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal"
        },
        {
            "name": "pytest: 当前文件",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-vv", "-s", "${file}"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}",
            "justMyCode": false,
            "purpose": ["debug-test"]
        },
        {
            "name": "pytest: 全部测试",
            "type": "debugpy",
            "request": "launch",
            "module": "pytest",
            "args": ["-vv"],
            "console": "integratedTerminal",
            "cwd": "${workspaceFolder}/tests",
            "justMyCode": false
        }
    ]
}